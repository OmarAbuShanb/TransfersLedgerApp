<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.TransfersLedger.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackColor">@color/switch_track_tint</item>
        <item name="thumbColor">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackDecorationTint">@color/switch_outline_tint</item>
    </style>

    <!-- Dialog window animation styles.
         Android applies these automatically for every dismiss path:
         dismiss(), back press, and outside-tap. -->

    <style name="DialogWindowAnimation_BottomScaleFade">
        <item name="android:windowEnterAnimation">@anim/dialog_bottom_scale_fade_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_bottom_scale_fade_exit</item>
    </style>

    <style name="DialogWindowAnimation_HorizontalSlide">
        <item name="android:windowEnterAnimation">@anim/dialog_horizontal_slide_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_horizontal_slide_exit</item>
    </style>

    <!-- Applied via ContextThemeWrapper(requireContext(), ...) in code.
         Using a ThemeOverlay (not a full Theme) means this style overlays
         ON TOP of the app's already-resolved DayNight context, so every
         @color reference automatically picks the correct night/day value
         from values-night/colors.xml or values/colors.xml. -->
    <style name="ThemeOverlay.App.DatePickerDialog" parent="ThemeOverlay.Material3.MaterialCalendar">
        <!-- Disable extra dim layer when DatePicker opens over another dialog -->
        <item name="android:backgroundDimEnabled">false</item>

        <!-- Primary accent drives the selected day circle, range highlight,
             and action button text. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorTertiary">@color/primary</item>

        <!-- Surface tokens — inherited from app's DayNight context via
             ContextThemeWrapper; we re-declare them explicitly so any inner
             dialog surface also stays on-brand. -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>

        <!-- Legacy android:* namespace — still read by CalendarView / DatePicker
             widget internals on older API levels. -->
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:headerBackground">@color/primary</item>
        <item name="android:numbersSelectorColor">@color/primary</item>

        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.DatePicker.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.DatePicker.Button</item>
    </style>

    <style name="Widget.App.DatePicker.Button" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="ThemeOverlay.App.DatePicker" parent="ThemeOverlay.App.DatePickerDialog" />

</resources>
