<?xml version="1.0" encoding="utf-8"?>
<!--
    Status-bar notification icon: spiral-bound ledger book.
    Redesigned for readability at small sizes:
      - Only 3 rings, but much larger (outer r=2, inner hole r=1)
      - 3 thick ruled lines inside the book body (visible at 17–24dp)
      - A bold right-pointing arrow "→" in the centre as the transfer symbol
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- ── Book body ── -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7,3 L21,3 C21.55,3 22,3.45 22,4 L22,20 C22,20.55 21.55,21 21,21 L7,21 Z" />

    <!-- Left spine strip (semi-transparent so rings punch through it visually) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.35"
        android:pathData="M5,3 L7,3 L7,21 L5,21 Z" />

    <!-- ── 3 large spiral rings (donut shapes, evenOdd fill) ── -->
    <!-- Ring 1  (top) – centre (4, 7) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M2,7 A2,2 0 0 1 6,7 A2,2 0 0 1 2,7 Z
            M3.2,7 A0.8,0.8 0 0 0 4.8,7 A0.8,0.8 0 0 0 3.2,7 Z" />

    <!-- Ring 2  (middle) – centre (4, 12) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M2,12 A2,2 0 0 1 6,12 A2,2 0 0 1 2,12 Z
            M3.2,12 A0.8,0.8 0 0 0 4.8,12 A0.8,0.8 0 0 0 3.2,12 Z" />

    <!-- Ring 3  (bottom) – centre (4, 17) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M2,17 A2,2 0 0 1 6,17 A2,2 0 0 1 2,17 Z
            M3.2,17 A0.8,0.8 0 0 0 4.8,17 A0.8,0.8 0 0 0 3.2,17 Z" />

    <!-- ── Bold right-arrow inside the book body ── -->
    <!-- Arrow shaft -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M9,11 L18,11 L18,13 L9,13 Z" />
    <!-- Arrow head -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M17,8.5 L21,12 L17,15.5 Z" />

</vector>
